 "strings": {
  "NSCameraUsageDescription": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Scan the QR code Blurt shows on your computer to pair."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "扫描电脑端口喷鸡显示的二维码以配对。"
     }
    }
   }
  },
  "NSLocalNetworkUsageDescription": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Find and connect to Blurt on your computer."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "查找并连接电脑端的口喷鸡。"
     }
    }
   }
  },
  "NSMicrophoneUsageDescription": {
   "extractionState": "manual",
   "localizations": {
    "en": {
     "stringUnit": {
      "state": "translated",
      "value": "Send dictation audio from this device to your paired computer."
     }
    },
    "zh-Hans": {
     "stringUnit": {
      "state": "translated",
      "value": "把本机麦克风录到的听写音频发送到已配对的电脑。"
     }
    }
   }
  }
 }
}