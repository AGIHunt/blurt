    },
    "A still screen uses no data. On a poor network the picture steps down by itself, and text sharpens as soon as it stops moving." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面不动时不用流量。网络差时画质会自动降低，画面一停下文字就会变清晰。"
          }
        }
      }
    },
