{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blurt",
  "mainBinaryName": "blurt",
  "version": "1.0.17",
  "identifier": "dev.blurt.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm --filter @blurt/desktop dev",
      "cwd": "../../../web"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "pnpm --filter @blurt/overlays build && pnpm --filter @blurt/desktop build",
      "cwd": "../../../web"
    },
    "frontendDist": "../../../web/apps/desktop/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Blurt",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Blurt/**",
          "$HOME/.blurt/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage",
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Speak, snap, record — Blurt turns it into work for your coding agents",
    "longDescription": "Talk through your screen, take a screenshot or leave a voice note; Blurt organizes it into issues, ideas, notes and tasks, files them into your project folders, and copies a hand-off note for Claude Code, Codex or any agent you use.",
    "homepage": "https://blurt.work",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../skills/blurt/scripts/*.py": "scripts/",
      "../../../skills/blurt/scripts/*.json": "scripts/",
      "../../../skills/blurt/scripts/.python-version": "scripts/.python-version",
      "../../../skills/blurt/scripts/review.html": "scripts/review.html",
      "../../../skills/blurt/models/*": "models/",
      "sounds/*.wav": "sounds/"
    },
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "headerImage": "icons/installer-header.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.39)",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "ffmpeg",
          "libportaudio2",
          "python3",
          "gstreamer1.0-tools",
          "gstreamer1.0-pipewire",
          "gstreamer1.0-plugins-base",
          "pipewire-bin",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-ugly",
          "gstreamer1.0-plugins-bad",
          "libpipewire-0.3-0"
        ],
        "recommends": [
          "gstreamer1.0-plugins-extra"
        ],
        "files": {
          "/usr/share/applications/dev.blurt.desktop.desktop": "linux/dev.blurt.desktop.desktop"
        }
      },
      "rpm": {
        "depends": [
          "libc.so.6(GLIBC_2.39)(64bit)",
          "webkit2gtk4.1",
          "gtk3",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "pipewire-libs"
        ],
        "recommends": [
          "gstreamer1-plugin-openh264",
          "gstreamer1-plugins-ugly"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "blurt"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://blurt.work/updates/desktop/{{target}}-{{arch}}.json"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
