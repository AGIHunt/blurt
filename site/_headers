# Cloudflare Pages. Every file a page uses is referenced with ?v= (README: bump it whenever one changes), so browsers
# keep them for a year and never ask again; a new page names new URLs. The pages themselves always revalidate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/style.css
  Cache-Control: public, max-age=31536000, immutable
# peep.js and main.js are inlined into the pages; the files stay as their source
/main.js
  Cache-Control: public, max-age=0, must-revalidate
/peep.js
  Cache-Control: public, max-age=0, must-revalidate
/llms.txt
  Content-Type: text/plain; charset=utf-8
# the app's curated model list (skills/blurt/scripts/curated_models.json; the app checks it at most once a day)
/models/*
  Cache-Control: public, max-age=3600
  Content-Type: application/json; charset=utf-8
