{
  "name": "@blurt/review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Blurt review canvas: one React component for review.py's browser page, the macOS app (WKWebView) and the Tauri app (design doc §5 C6).",
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.ts",
    "./style.css": "./src/styles/review.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build && node scripts/publish.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:wkwebview": "node scripts/wkwebview.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@blurt/ui": "workspace:*",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "3.2.4"
  }
}
