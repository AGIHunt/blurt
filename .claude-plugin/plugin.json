{
  "name": "blurt",
  "version": "0.5.0",
  "description": "Show it. Say it. Your AI gets it — record your screen, talk, get bugs, ideas and todos back. 边看边喷，AI 全懂。",
  "license": "MIT",
  "keywords": [
    "feedback",
    "bug-report",
    "screen-recording",
    "asr",
    "feishu",
    "qa"
  ],
  "repository": "https://github.com/AGIHunt/blurt",
  "homepage": "https://github.com/AGIHunt/blurt",
  "author": {
    "name": "AGI Hunt"
  },
  "mcpServers": {
    "blurt": {
      "command": "uv",
      "args": ["run", "-q", "--script", "${CLAUDE_PLUGIN_ROOT}/skills/blurt/scripts/mcp_server.py"]
    }
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "-q", "--script", "${CLAUDE_PLUGIN_ROOT}/skills/blurt/scripts/index.py", "update",
                     "--workspace", "${CLAUDE_PROJECT_DIR}"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
