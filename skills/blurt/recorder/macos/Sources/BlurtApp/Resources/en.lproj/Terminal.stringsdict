		</dict>
	</dict>
	<key>notify.many.running</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld session is working</string>
			<key>other</key>
			<string>%ld sessions are working</string>
		</dict>
	</dict>
	<key>notify.many.turn_done</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld session finished a turn</string>
			<key>other</key>
			<string>%ld sessions finished a turn</string>
		</dict>
	</dict>
	<key>notify.many.waiting_input</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld session needs your input</string>
			<key>other</key>
			<string>%ld sessions need your input</string>
		</dict>
	</dict>
	<key>finish.done.discard_taken_back</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Discarded. Its item is back in To Do.</string>
			<key>other</key>
			<string>Discarded. Its %ld items are back in To Do.</string>
		</dict>
	</dict>
</dict>
</plist>
